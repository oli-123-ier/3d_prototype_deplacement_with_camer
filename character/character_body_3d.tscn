[sub_resource type="GDScript" id="GDScript_hfe7o"]
script/source = "extends CharacterBody3D

@export_group(\"camera\")
@export_range(0.0, 1.0) var mouse_sensitivity := 0.25
@onready var animation_player: AnimationPlayer = $playe2/AnimationPlayer

@export_group(\"Mouvement\")
@export var move_speed := 8.0
@export var accelerate := 20.0 
@export var rotatio_speed = 12.0
@export var jump_implusion = 15.0

var _camera_input_direction = Vector2.ZERO
var _last_mouvement_direction = Vector3.BACK
var gravity = -30.0

@onready var _camera_pivot:Node3D = %cameraPivot
@onready var _camera:Camera3D = %Camera3D
@onready var _skin = $playe2

func _input(event: InputEvent) -> void:
	if event.is_action_pressed(\"left_click\"):
		Input.mouse_mode = Input.MOUSE_MODE_CAPTURED
	if event.is_action_pressed(\"ui_cancel\"):
		Input.mouse_mode = Input.MOUSE_MODE_VISIBLE

func _unhandled_input(event: InputEvent) -> void:
	var is_camera_motion = (
		event is InputEventMouseMotion and 
		Input.get_mouse_mode() == Input.MOUSE_MODE_CAPTURED 
	)#CONDITION POUR VEIRFIE QUE LA SOURIS EST BELLE ET BIEN DANS LA FENTRE avant de tourner la camera
	 
	if is_camera_motion:
		_camera_input_direction = event.screen_relative * mouse_sensitivity

func _physics_process(delta: float) -> void:
	_camera_pivot.rotation.x += _camera_input_direction.y * delta#TOURNE AUTOUR DE L'AXE X
	_camera_pivot.rotation.x = clamp(_camera_pivot.rotation.x,-PI/6.0, PI/3.0)
	_camera_pivot.rotation.y -= _camera_input_direction.x * delta#TOURNE AUTOUR DE L'AXE y
	
	_camera_input_direction = Vector2.ZERO
	#move third person charater
	#1-get input vector
	var raw_input = Input.get_vector(\"move_left\",\"move_right\",\"move_up\",\"move_down\")
	#2-extract foward and right direction vector
	var foward = _camera.global_basis.z
	var right = _camera.global_basis.x
	#3-calculate move direction
	var move_direction = foward*raw_input.y + right*raw_input.x
	move_direction.y = 0.0
	move_direction = move_direction.normalized()
	#4-calculate character velocity
	
	var y_velocity = velocity.y 
	velocity.y = 0.0
	velocity = velocity.move_toward(move_direction*move_speed, accelerate*delta)
	#le joueur tombe
	velocity.y = y_velocity + gravity*delta	
	#jump
	var is_starting_jump = Input.is_action_pressed(\"jump\") and is_on_floor()
	if is_starting_jump : 
		velocity.y += jump_implusion
		
	#5-move character 
	move_and_slide()
	if move_direction.length() > 0.2 :
		_last_mouvement_direction = move_direction
	var target_angle = Vector3.BACK.signed_angle_to(_last_mouvement_direction, Vector3.UP)
	_skin.global_rotation.y = lerp_angle(_skin.rotation.y, target_angle,rotatio_speed*delta) 

	#jouez des animations
	if is_starting_jump:
		animation_player.play(\"jump\")
	elif not is_on_floor() and velocity.y < 0:
		animation_player.play(\"falling_idle\")
	elif is_on_floor():
		var ground_speed = velocity.length()
		if ground_speed > 0.0:
			animation_player.play(\"run\")
		
		else :
			animation_player.play(\"idle\")
			
		
"

